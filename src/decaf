#!/usr/bin/env bash
#
# decaf: suspend the system after a while.
#
# The design, and the reasons behind it, are in docs/DESIGN.md.
#
# Layers, top to bottom. Each calls only the layers below it.
#   cli     argv → validated values; prints messages; maps results to exit codes
#   core    timer operations on validated values: on, off, status
#   system  the only code that runs external commands; validates what they
#           return and reports its own failures (not written yet)
#   values  pure functions: no I/O besides printing the result
#
# Conventions:
#   - Globals are readonly constants. Everything else is `local`.
#   - Functions return data on stdout and a status as their exit code.
#     Only `main`'s caller exits.
#   - Errors propagate explicitly with `|| return`. `set -e` is not relied on
#     inside functions, because Bash disables it in many contexts.
#   - The layer that detects a problem reports it, except the core: it returns
#     a code, and the cli turns it into a message.
#   - Never do arithmetic on an unvalidated string: Bash evaluates it as an
#     expression, which can run commands. Validate with a regex first.

VERSION="1.0.5"
readonly VERSION

# Exit codes. Each has one meaning across all commands.
readonly EXIT_USAGE=2
readonly EXIT_SYSTEM=4

readonly MAX_DURATION=2147483647

# --- values ------------------------------------------------------------------

# is_duration STRING
# Succeeds if STRING is a DURATION: whole seconds with no sign or leading zeros,
# from 1 to MAX_DURATION.
is_duration() {
    local -r value="$1"
    [[ "$value" =~ ^[1-9][0-9]*$ ]] || return 1
    # Compare lengths before values, so a huge number can't overflow.
    ((${#value} < ${#MAX_DURATION})) && return 0
    ((${#value} == ${#MAX_DURATION} && value <= MAX_DURATION))
}

# format_status DURATION STARTED NOW
# Print the `status` output for a running timer. All arguments must be validated.
format_status() {
    local -r duration="$1" started="$2" now="$3"
    local -r until=$((started + duration))
    printf '%s\n' \
        "state=on" \
        "duration=$duration" \
        "started=$started" \
        "until=$until" \
        "remaining=$((until > now ? until - now : 0))"
}

# --- system ------------------------------------------------------------------

# err MESSAGE: print an error message to stderr.
err() {
    printf 'decaf: %s\n' "$1" >&2
}

# --- core --------------------------------------------------------------------
# Placeholders until the system layer exists (step 3 of the rewrite).

core_on() {
    err "'on' is not implemented yet"
    return "$EXIT_SYSTEM"
}

core_off() {
    err "'off' is not implemented yet"
    return "$EXIT_SYSTEM"
}

core_status() {
    err "'status' is not implemented yet"
    return "$EXIT_SYSTEM"
}

# --- cli ---------------------------------------------------------------------

# usage_error MESSAGE: report a usage error. Returns EXIT_USAGE, so callers can
# write `check || usage_error "..." || return`.
usage_error() {
    err "$1"
    printf "Try 'decaf --help' for more information.\n" >&2
    return "$EXIT_USAGE"
}

cli_help() {
    cat <<EOF
Usage: decaf on DURATION
       decaf off
       decaf status
       decaf --help | --version

Suspend the system after a while, even if other programs try to keep it awake.

Commands:
  on DURATION  Suspend in DURATION seconds (1 or more).
  off          Cancel the timer.
  status       Print the timer state as key=value lines.

Exit codes: 0 success or timer on, 1 no timer, 2 usage error,
            3 timer already on, 4 system error.

See 'man decaf' for details.
EOF
}

# cli_no_args COMMAND ARG...
# Succeeds if COMMAND was given no arguments.
cli_no_args() {
    local -r command="$1"
    shift
    (($# == 0)) || usage_error "'$command' takes no arguments"
}

# cli_parse_on ARG...
# Validate the arguments of `on`. Prints DURATION.
cli_parse_on() {
    local duration="" arg
    for arg in "$@"; do
        case "$arg" in
        -*[!0-9]* | -)
            usage_error "unknown option '$arg'" || return
            ;;
        *)
            # Also reached by negative numbers, which is_duration rejects.
            [[ -z "$duration" ]] || usage_error "unexpected argument '$arg'" || return
            is_duration "$arg" ||
                usage_error "invalid DURATION '$arg': expected whole seconds from 1 to $MAX_DURATION" ||
                return
            duration="$arg"
            ;;
        esac
    done
    [[ -n "$duration" ]] || usage_error "missing DURATION" || return
    printf '%s\n' "$duration"
}

cli_on() {
    local duration
    duration="$(cli_parse_on "$@")" || return
    core_on "$duration"
}

main() {
    (($# > 0)) || usage_error "missing command" || return
    local -r command="$1"
    shift
    case "$command" in
    on) cli_on "$@" ;;
    off)
        cli_no_args "$command" "$@" || return
        core_off
        ;;
    status)
        cli_no_args "$command" "$@" || return
        core_status
        ;;
    --help)
        cli_no_args "$command" "$@" || return
        cli_help
        ;;
    --version)
        cli_no_args "$command" "$@" || return
        printf 'decaf %s\n' "$VERSION"
        ;;
    *) usage_error "unknown command '$command'" ;;
    esac
}

# Run only when executed, not when sourced (the tests source this file).
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    set -euo pipefail
    main "$@"
fi
