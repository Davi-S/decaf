#!/usr/bin/env bash
#
# decaf: suspend the system after a while.
#
# The design, and the reasons behind it, are in docs/DESIGN.md.
#
# Layers, top to bottom. Each calls only the layers below it.
#   cli     argv → validated values; prints messages; maps results to exit codes
#   core    timer operations on validated values: on, off, status
#   system  the only code that runs external commands; validates what they
#           return and reports its own failures
#   values  pure functions: no I/O besides printing the result
#
# Conventions:
#   - Globals are readonly constants. Everything else is `local`.
#   - Functions return data on stdout and a status as their exit code.
#     Only `main`'s caller exits.
#   - Errors propagate explicitly with `|| return`. `set -e` is not relied on
#     inside functions, because Bash disables it in many contexts.
#   - The layer that detects a problem reports it, except the core: it returns
#     a code, and the cli turns it into a message.
#   - Never do arithmetic on an unvalidated string: Bash evaluates it as an
#     expression, which can run commands. Validate with a regex first.

VERSION="1.0.5"
readonly VERSION

# Exit codes. Each has one meaning across all commands.
readonly EXIT_NO_TIMER=1
readonly EXIT_USAGE=2
readonly EXIT_ALREADY_ON=3
readonly EXIT_SYSTEM=4

readonly MAX_DURATION=2147483647

# The systemd user unit that runs the timer. It exists only while a timer is on.
readonly UNIT="app-decaf.service"

# `_wait` exits with this code when it skips the suspend; the unit counts it as
# a success (SuccessExitStatus), and `_stopped` reads it (step 4).
readonly WAIT_SKIPPED=10

# This script's absolute path, for the unit to run `_wait` and `_stopped`.
SELF="${BASH_SOURCE[0]}"
[[ "$SELF" == /* ]] || SELF="$PWD/$SELF"
readonly SELF

# --- values ------------------------------------------------------------------

# is_duration STRING
# Succeeds if STRING is a DURATION: whole seconds with no sign or leading zeros,
# from 1 to MAX_DURATION.
is_duration() {
    local -r value="$1"
    [[ "$value" =~ ^[1-9][0-9]*$ ]] || return 1
    # Compare lengths before values, so a huge number can't overflow.
    ((${#value} < ${#MAX_DURATION})) && return 0
    ((${#value} == ${#MAX_DURATION} && value <= MAX_DURATION))
}

# is_timestamp STRING
# Succeeds if STRING is a Unix timestamp: at most 12 digits (year 33658), which
# leaves room to add any DURATION without overflow.
is_timestamp() {
    [[ "$1" =~ ^(0|[1-9][0-9]{0,11})$ ]]
}

# is_safe_path STRING
# Succeeds if STRING is an absolute path systemd reads literally: no spaces,
# quotes, `$` or `%`, which systemd would split, unquote or expand.
is_safe_path() {
    [[ "$1" =~ ^/[A-Za-z0-9/._+-]+$ ]]
}

# parse_timer_values DURATION STARTED
# Validate a timer's values, as stored in the unit's environment. Prints them
# space-separated, in this order.
parse_timer_values() {
    is_duration "$1" || return 1
    is_timestamp "$2" || return 1
    printf '%s %s\n' "$1" "$2"
}

# parse_unit_properties TEXT
# Parse the output of `systemctl show --property=ActiveState --property=Environment`.
# Prints "inactive", or "active DURATION STARTED" for a running timer.
# Fails if the unit is active but lacks valid decaf values.
parse_unit_properties() {
    local line active_state="" environment=""
    while IFS= read -r line; do
        case "$line" in
        ActiveState=*) active_state="${line#*=}" ;;
        Environment=*) environment="${line#*=}" ;;
        esac
    done <<<"$1"

    if [[ "$active_state" != active ]]; then
        printf 'inactive\n'
        return 0
    fi

    local variables variable duration="" started=""
    read -ra variables <<<"$environment"
    for variable in "${variables[@]}"; do
        case "$variable" in
        DECAF_DURATION=*) duration="${variable#*=}" ;;
        DECAF_STARTED=*) started="${variable#*=}" ;;
        esac
    done
    local values
    values="$(parse_timer_values "$duration" "$started")" || return 1
    printf 'active %s\n' "$values"
}

# format_status DURATION STARTED NOW
# Print the `status` output for a running timer. All arguments must be validated.
format_status() {
    local -r duration="$1" started="$2" now="$3"
    local -r until=$((started + duration))
    printf '%s\n' \
        "state=on" \
        "duration=$duration" \
        "started=$started" \
        "until=$until" \
        "remaining=$((until > now ? until - now : 0))"
}

# --- system ------------------------------------------------------------------

# err MESSAGE: print an error message to stderr.
err() {
    printf 'decaf: %s\n' "$1" >&2
}

# sys_now: print the current Unix time.
sys_now() {
    local now
    if ! now="$(date +%s)" || ! is_timestamp "$now"; then
        err "could not read the current time"
        return "$EXIT_SYSTEM"
    fi
    printf '%s\n' "$now"
}

# sys_unit_state
# Print the timer's state as parse_unit_properties does: "inactive", or
# "active DURATION STARTED".
sys_unit_state() {
    local properties
    properties="$(systemctl --user show --property=ActiveState --property=Environment "$UNIT")" || {
        err "could not read the timer state from systemd"
        return "$EXIT_SYSTEM"
    }
    parse_unit_properties "$properties" || {
        err "$UNIT is running but was not started by this version of decaf"
        return "$EXIT_SYSTEM"
    }
}

# sys_unit_start DURATION STARTED
# Start the timer unit. It runs `_wait`, which suspends the system at the
# deadline, and `_stopped` when it stops.
sys_unit_start() {
    local -r duration="$1" started="$2"
    is_safe_path "$SELF" || {
        err "cannot run from '$SELF': the path may only contain letters, digits and / . _ + -"
        return "$EXIT_SYSTEM"
    }
    systemd-run --user --quiet --collect \
        --unit="$UNIT" --slice=app.slice \
        --description="decaf: suspend the system after a while" \
        --setenv=DECAF_STARTED="$started" \
        --setenv=DECAF_DURATION="$duration" \
        --property=ExecStopPost="$SELF _stopped" \
        --property=SuccessExitStatus="$WAIT_SKIPPED" \
        -- "$SELF" _wait || {
        err "could not start the timer"
        return "$EXIT_SYSTEM"
    }
}

# sys_unit_stop: stop the timer unit. Returns once it is fully stopped.
sys_unit_stop() {
    systemctl --user stop "$UNIT" || {
        err "could not stop the timer"
        return "$EXIT_SYSTEM"
    }
}

# --- core --------------------------------------------------------------------

# core_on DURATION
core_on() {
    local -r duration="$1"
    local state now
    state="$(sys_unit_state)" || return
    [[ "$state" == inactive ]] || return "$EXIT_ALREADY_ON"
    now="$(sys_now)" || return
    sys_unit_start "$duration" "$now"
}

core_off() {
    local state
    state="$(sys_unit_state)" || return
    [[ "$state" != inactive ]] || return "$EXIT_NO_TIMER"
    sys_unit_stop
}

# core_status: print the status record. Returns EXIT_NO_TIMER when off.
core_status() {
    local state now
    state="$(sys_unit_state)" || return
    if [[ "$state" == inactive ]]; then
        printf 'state=off\n'
        return "$EXIT_NO_TIMER"
    fi
    local duration started
    read -r _ duration started <<<"$state"
    now="$(sys_now)" || return
    format_status "$duration" "$started" "$now"
}

# --- cli ---------------------------------------------------------------------

# usage_error MESSAGE: report a usage error. Returns EXIT_USAGE, so callers can
# write `check || usage_error "..." || return`.
usage_error() {
    err "$1"
    printf "Try 'decaf --help' for more information.\n" >&2
    return "$EXIT_USAGE"
}

cli_help() {
    cat <<EOF
Usage: decaf on DURATION
       decaf off
       decaf status
       decaf --help | --version

Suspend the system after a while, even if other programs try to keep it awake.

Commands:
  on DURATION  Suspend in DURATION seconds (1 or more).
  off          Cancel the timer.
  status       Print the timer state as key=value lines.

Exit codes: 0 success or timer on, 1 no timer, 2 usage error,
            3 timer already on, 4 system error.

See 'man decaf' for details.
EOF
}

# cli_no_args COMMAND ARG...
# Succeeds if COMMAND was given no arguments.
cli_no_args() {
    local -r command="$1"
    shift
    (($# == 0)) || usage_error "'$command' takes no arguments"
}

# cli_parse_on ARG...
# Validate the arguments of `on`. Prints DURATION.
cli_parse_on() {
    local duration="" arg
    for arg in "$@"; do
        case "$arg" in
        -*[!0-9]* | -)
            usage_error "unknown option '$arg'" || return
            ;;
        *)
            # Also reached by negative numbers, which is_duration rejects.
            [[ -z "$duration" ]] || usage_error "unexpected argument '$arg'" || return
            is_duration "$arg" ||
                usage_error "invalid DURATION '$arg': expected whole seconds from 1 to $MAX_DURATION" ||
                return
            duration="$arg"
            ;;
        esac
    done
    [[ -n "$duration" ]] || usage_error "missing DURATION" || return
    printf '%s\n' "$duration"
}

cli_on() {
    local duration
    duration="$(cli_parse_on "$@")" || return
    core_on "$duration" && return
    local -r code=$?
    if ((code == EXIT_ALREADY_ON)); then
        err "a timer is already on; run 'decaf off' first"
    fi
    return "$code"
}

cli_off() {
    cli_no_args off "$@" || return
    core_off && return
    local -r code=$?
    if ((code == EXIT_NO_TIMER)); then
        err "no timer is on"
    fi
    return "$code"
}

cli_status() {
    cli_no_args status "$@" || return
    core_status
}

main() {
    (($# > 0)) || usage_error "missing command" || return
    local -r command="$1"
    shift
    case "$command" in
    on) cli_on "$@" ;;
    off) cli_off "$@" ;;
    status) cli_status "$@" ;;
    --help)
        cli_no_args "$command" "$@" || return
        cli_help
        ;;
    --version)
        cli_no_args "$command" "$@" || return
        printf 'decaf %s\n' "$VERSION"
        ;;
    *) usage_error "unknown command '$command'" ;;
    esac
}

# Run only when executed, not when sourced (the tests source this file).
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    set -euo pipefail
    main "$@"
fi
